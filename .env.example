# --- For CometAPI (https://www.cometapi.com/console/) ---
# LLM_BASE_URL="https://api.cometapi.com/v1"
# LLM_API_KEY="your_comet_api_key"
# LLM_MODEL="gpt-4o-mini"

# --- For Local LM Studio (default) ---
LLM_BASE_URL="http://localhost:1234/v1"
LLM_API_KEY="lm-studio"
LLM_MODEL="local-model"

# Optional: path overrides
KB_PATH="kb.ttl"
QA_PATH="MetaQA/1-hop/ntm/qa_dev.txt"

# Optional: limit number of questions evaluated (useful for quick smoke tests)
MAX_QUESTIONS="50"

# --- Entity linking (BLINK-style bi-encoder + FAISS) ---
# fastembed runs locally on CPU (ONNX, no torch). "openai" uses the /embeddings endpoint of EMBED_BASE_URL
# (defaults to LLM_BASE_URL), e.g. an embedding model loaded in LM Studio.
EMBED_BACKEND="fastembed"
EMBED_MODEL="BAAI/bge-small-en-v1.5"
# Entity vectors are computed once per KB + model and cached here.
CACHE_DIR=".cache"
LINK_TOP_K="5"
LINK_MIN_SCORE="0.75"

# --- Planning (RoG-style relation paths) ---
MAX_PLANS="3"
MAX_HOPS="4"
# Extra LLM calls allowed when every plan returns nothing (0 = strictly one LLM call per question)
REPLAN_ROUNDS="1"
